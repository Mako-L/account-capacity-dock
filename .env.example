# Optional shell environment overrides, for use with: set -a; source .env; set +a
# The CLI persists paths in ~/.mako-capacity/settings.json during init/install.
# Default: ~/.mako-capacity/claude-proxy (CLIProxyAPI, which serves Claude and Codex).
CLAUDE_PROXY_DIR=/Users/your-name/claude-proxy
CLAUDE_PROXY_PORT=8317
# Optional Cursor CLI data directory (for example, a Windows-accessible WSL path).
# CURSOR_DIR=/path/to/.cursor
# Optional legacy Codex Proxy directory; read only while CLIProxyAPI has no Codex login.
# CODEX_PROXY_DIR=/Users/your-name/codex-proxy
