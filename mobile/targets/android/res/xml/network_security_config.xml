<?xml version="1.0" encoding="utf-8"?>
<!-- The proxy serves plain http on the Mac's LAN or Tailscale address; features/capacity/proxy.ts only accepts http for private hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
