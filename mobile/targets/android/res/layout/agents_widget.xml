<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agents_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/capacity_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/agents_widget_label"
        android:textColor="@color/capacity_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/agents_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/agents_widget_empty"
        android:textColor="@color/capacity_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/agents_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
